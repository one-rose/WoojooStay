# 서버
PORT=4000
NODE_ENV=development
# 프론트(Next.js) 주소 — CORS 허용 (쉼표로 여러 개, 문자 링크는 첫 번째 주소)
WEB_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/uzustay

# 토큰 서명 키 (32자 이상 임의 문자열)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# 채널 계정 정보 암호화 키 (32바이트를 base64 로: openssl rand -base64 32)
CREDENTIALS_KEY=

# AI 답글 — 비워 두면 템플릿 답글로 동작
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# 채널 자동 수집 (30분마다)
SYNC_ENABLED=false

# 영수증 사진 저장 폴더
UPLOAD_DIR=./uploads

# 화면 서버 ↔ API 내부 키 (32자 이상) — x-internal-key 가 맞으면 x-client-ip 로 요청 제한
# INTERNAL_API_KEY=
# 새 업장 무료 체험 일수 (파일럿 56)
TRIAL_DAYS=30
# 운영에서 문자·결제 키 없이 일부러 띄울 때만 true
ALLOW_FAKE_INTEGRATIONS=false

# 모바일 앱
# 앱 푸시 (FCM HTTP v1) — Firebase 서비스 계정 JSON 원문 또는 파일 경로. 비워 두면 푸시는 로그에만
FCM_SERVICE_ACCOUNT_JSON=
# 출근 QR 서명 키 (32자 이상). 비워 두면 JWT_ACCESS_SECRET 에서 만든다 — 그러면 그 키를 바꿀 때 QR 을 모두 새로 인쇄
CLOCK_QR_SECRET=
# 강제 업데이트 — 이 버전보다 낮은 앱은 업데이트 화면
APP_MIN_VERSION_ANDROID=1.0.0
APP_MIN_VERSION_IOS=1.0.0
APP_LATEST_VERSION_ANDROID=
APP_LATEST_VERSION_IOS=
APP_STORE_URL_ANDROID=
APP_STORE_URL_IOS=
# 앱이 여는 웹 주소 (비워 두면 WEB_ORIGIN 첫 번째)
APP_WEB_BASE_URL=
# 고객센터 전화 (비워 두면 앱에 안 보임)
SUPPORT_PHONE=
