// 우주스테이 API 데이터 모델
// 기능 ID 는 기능정의서(26-11-08) 기준
//
// 이름 규칙 (docs/DB-NAMING.md)
// - 테이블: wj_ + 단수 snake_case            예) wj_user, wj_property_member
// - 컬럼: snake_case, FK 는 <대상>_id        예) property_id
// - 시각 *_at(timestamptz) · 날짜 *_date(date) · 여부 is_* · 금액 *_amount · 개수 *_count · 코드 *_code · 상태 status
// - enum 타입: wj_ + snake_case             예) wj_member_role
// 코드(Prisma 모델·필드)는 camelCase 를 쓰고 @@map / @map 으로 DB 이름에 연결한다.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ═══ 회원 · 인증 (F0-01, F0-17) ═══════════════════════════════

model User {
  id                String    @id @default(uuid()) @db.Uuid
  phone             String    @unique @map("phone_no") // 숫자만, 로그인 아이디
  name              String    @map("user_name")
  email             String?
  passwordHash      String    @map("password_hash")
  termsAgreedAt     DateTime  @map("terms_agreed_at") @db.Timestamptz
  privacyAgreedAt   DateTime  @map("privacy_agreed_at") @db.Timestamptz
  marketingAgreedAt DateTime? @map("marketing_agreed_at") @db.Timestamptz
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships   Membership[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  noticeConfigs NotificationSetting[]
  repliesPosted Reply[]
  employees     Employee[]
  opsNotes      OpsNote[]
  opsNoteReads  OpsNoteRead[]
  roomChanges   RoomStatusLog[]

  @@map("wj_user")
}

enum VerificationPurpose {
  SIGNUP
  RESET_PASSWORD

  @@map("wj_verification_purpose")
}

model PhoneVerification {
  id         String              @id @default(uuid()) @db.Uuid
  phone      String              @map("phone_no")
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  attempts   Int                 @default(0) @map("attempt_count")
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz
  verifiedAt DateTime?           @map("verified_at") @db.Timestamptz
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, purpose, createdAt])
  @@map("wj_phone_verification")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  /// 새 토큰으로 바꿔 줘서 폐기됨 (로그아웃·비밀번호 재설정 폐기와 구분 — 재사용 감지용)
  isRotated Boolean   @default(false) @map("is_rotated")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wj_refresh_token")
}

/// 사장님이 보내는 문자(초대·초대 다시 보내기·근로계약서) 기록 — 계정별 하루 한도
model SmsSendLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String   @map("sms_kind") // INVITE · INVITE_RESEND · CONTRACT
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@map("wj_sms_send_log")
}

// ═══ 운영자 (F0-14, F0-16) ════════════════════════════════════

enum AdminRole {
  SUPER // 운영자 계정 관리까지
  OPERATOR

  @@map("wj_admin_role")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String    @map("admin_name")
  passwordHash String    @map("password_hash")
  role         AdminRole @default(OPERATOR) @map("admin_role")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  managedProperties Property[]
  handledInquiries  Inquiry[]
  supportNotes      SupportNote[]

  @@map("wj_admin_user")
}

enum InquiryType {
  INTRO // 도입 문의
  PARTNER // 파트너 문의

  @@map("wj_inquiry_type")
}

enum InquiryStatus {
  NEW
  CONTACTED
  DONE

  @@map("wj_inquiry_status")
}

model Inquiry {
  id           String        @id @default(uuid()) @db.Uuid
  type         InquiryType   @map("inquiry_type")
  contactName  String        @map("contact_name")
  phone        String        @map("phone_no")
  email        String?
  propertyName String?       @map("property_name")
  propertyType PropertyType? @map("property_type")
  rooms        Int?          @map("room_count")
  message      String
  status       InquiryStatus @default(NEW)
  adminMemo    String?       @map("admin_memo")
  handledById  String?       @map("handled_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  handledBy AdminUser? @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("wj_inquiry")
}

// ═══ 업장 · 직원 계정 (F0-02, F0-03) ══════════════════════════

enum PropertyType {
  HOTEL
  MOTEL
  PENSION
  GUESTHOUSE
  OTHER

  @@map("wj_property_type")
}

enum Role {
  OWNER
  MANAGER
  STAFF

  @@map("wj_member_role")
}

model Property {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @map("property_name")
  type           PropertyType @map("property_type")
  address        String
  rooms          Int          @map("room_count")
  bizNo          String       @map("biz_reg_no") // 사업자등록번호 숫자 10자리
  bizVerified    Boolean      @default(false) @map("is_biz_verified")
  ownerName      String       @map("owner_name")
  phone          String?      @map("phone_no")
  managerId      String?      @map("manager_admin_id") @db.Uuid // 담당 운영 매니저
  /// 실증(파일럿) 묶음 이름 — 예 "대전 1차". null 이면 실증 업장 아님
  pilotGroup     String?      @map("pilot_group")
  /// 실증 시작일 — 1~8주 KPI 와 결제 유예(시작일 + 8주 전까지)의 기준
  pilotStartedAt DateTime?    @map("pilot_start_date") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  manager        AdminUser?            @relation(fields: [managerId], references: [id], onDelete: SetNull)
  memberships    Membership[]
  invitations    Invitation[]
  channels       ChannelConnection[]
  bookings       Booking[]
  settlements    Settlement[]
  adSpends       AdSpend[]
  channelPrices  ChannelPrice[]
  competitors    CompetitorPrice[]
  reviews        Review[]
  replySettings  ReplySettings?
  notifications  Notification[]
  noticeConfigs  NotificationSetting[]
  subscriptions  Subscription[]
  paymentMethods PaymentMethod[]
  payments       Payment[]
  employees      Employee[]
  expenses       Expense[]
  receipts       Receipt[]
  orders         PurchaseOrder[]
  roomUnits      Room[]
  opsNotes       OpsNote[]
  ratings        RatingSnapshot[]
  supportNotes   SupportNote[]
  pilotSurvey    PilotSurvey?

  @@index([pilotGroup])
  @@map("wj_property")
}

model Membership {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  role       Role     @map("member_role")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("wj_property_member")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @map("property_id") @db.Uuid
  phone       String    @map("phone_no")
  role        Role      @map("member_role")
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by") @db.Uuid
  /// 여러 업장에 함께 보낸 초대 묶음 — 같은 값끼리 링크 하나로 함께 수락 (단건 초대는 null)
  batchId     String?   @map("batch_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([batchId])
  @@map("wj_member_invitation")
}

// ═══ 채널 연동 · 수집 (F0-04 ~ F0-07) ═════════════════════════

enum Channel {
  YANOLJA
  YEOGI
  NAVER
  AGODA
  TRIP
  HOTELS
  ONDA
  KKUL
  DDNAYO

  @@map("wj_channel_code")
}

enum ConnectionStatus {
  CONNECTED
  SYNCING
  AUTH_EXPIRED
  ERROR

  @@map("wj_channel_status")
}

model ChannelConnection {
  id               String           @id @default(uuid()) @db.Uuid
  propertyId       String           @map("property_id") @db.Uuid
  channel          Channel          @map("channel_code")
  status           ConnectionStatus @default(SYNCING)
  /// AES-256-GCM 으로 암호화한 채널 계정 정보 (평문 저장 금지)
  credentials      String           @map("credential_enc")
  consentAt        DateTime         @map("consented_at") @db.Timestamptz
  lastSyncedAt     DateTime?        @map("last_synced_at") @db.Timestamptz
  lastError        String?          @map("last_error")
  consecutiveFails Int              @default(0) @map("fail_count")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, channel])
  @@map("wj_channel_account")
}

enum StayType {
  OVERNIGHT // 숙박
  DAYUSE // 대실

  @@map("wj_stay_type")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  NOSHOW

  @@map("wj_booking_status")
}

/// 채널 예약 (F0-06). 매출 집계의 원천 — 매출 기준일은 투숙일(checkin_date)
model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  propertyId    String        @map("property_id") @db.Uuid
  channel       Channel       @map("channel_code")
  reservationNo String        @map("reservation_no")
  guestName     String        @map("guest_name") // 마스킹된 이름
  roomType      String        @map("room_type_name")
  stayType      StayType      @default(OVERNIGHT) @map("stay_type")
  checkinDate   DateTime      @map("checkin_date") @db.Date
  checkoutDate  DateTime      @map("checkout_date") @db.Date
  checkinTime   String?       @map("checkin_time") // 대실 입실 "HH:mm"
  saleAmount    Int           @map("sale_amount")
  discount      Int           @default(0) @map("discount_amount")
  commission    Int           @default(0) @map("commission_amount")
  status        BookingStatus @default(CONFIRMED)
  bookedAt      DateTime      @map("booked_at") @db.Timestamptz
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, channel, reservationNo])
  @@index([propertyId, checkinDate])
  @@map("wj_booking")
}

/// 채널 정산 예정·완료 (F0-07)
model Settlement {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  channel      Channel  @map("channel_code")
  expectedDate DateTime @map("settle_date") @db.Date
  amount       Int      @map("settle_amount")
  settled      Boolean  @default(false) @map("is_settled")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, expectedDate])
  @@map("wj_settlement")
}

enum DataSource {
  CHANNEL
  MANUAL

  @@map("wj_data_source")
}

/// 월별 광고비 (F2-04) — 채널 수집 또는 직접 입력
model AdSpend {
  id         String     @id @default(uuid()) @db.Uuid
  propertyId String     @map("property_id") @db.Uuid
  channel    Channel    @map("channel_code")
  month      DateTime   @map("spend_month") @db.Date // 그 달 1일
  amount     Int        @map("spend_amount")
  source     DataSource @default(MANUAL)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, channel, month])
  @@map("wj_ad_spend")
}

/// 채널에 노출되는 우리 판매가 (F2-05)
model ChannelPrice {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  channel     Channel  @map("channel_code")
  roomType    String   @map("room_type_name")
  stayDate    DateTime @map("stay_date") @db.Date
  price       Int      @map("sale_price")
  collectedAt DateTime @default(now()) @map("collected_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, channel, roomType, stayDate])
  @@map("wj_channel_price")
}

/// 주변 경쟁 업소 가격 (F2-05)
model CompetitorPrice {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  name        String   @map("competitor_name")
  distanceM   Int      @map("distance_m")
  roomType    String   @map("room_type_name")
  stayDate    DateTime @map("stay_date") @db.Date
  price       Int      @map("sale_price")
  collectedAt DateTime @default(now()) @map("collected_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name, roomType, stayDate])
  @@map("wj_competitor_price")
}

// ═══ 리뷰 · AI 답글 (F1-01 ~ F1-08) ═══════════════════════════

enum ReviewStatus {
  UNANSWERED
  POSTING // 답글 게시 중 (채널 전송 중 — 동시에 두 번 게시되지 않게 먼저 잡아 둔다)
  POSTED

  @@map("wj_review_status")
}

enum Sentiment {
  POSITIVE
  IMPROVE

  @@map("wj_sentiment")
}

enum ReplyVia {
  API
  COPY
  AUTO
  /// 수집할 때 채널에 이미 달려 있던 답글 (우리 서비스로 단 답글이 아님 — 응답률·소요시간 KPI 에서 뺀다)
  EXTERNAL

  @@map("wj_reply_method")
}

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  propertyId  String       @map("property_id") @db.Uuid
  channel     Channel      @map("channel_code")
  externalId  String       @map("external_review_id")
  author      String       @map("author_name")
  rating      Int
  body        String       @map("content")
  photos      String[]     @map("photo_urls")
  roomType    String?      @map("room_type_name")
  stayDate    DateTime?    @map("stay_date") @db.Date
  postedAt    DateTime     @map("posted_at") @db.Timestamptz
  status      ReviewStatus @default(UNANSWERED)
  sentiment   Sentiment
  /// 실명·연락처·욕설 등 — 자동 게시 제외, 사람 확인 필요
  needsReview Boolean      @default(false) @map("is_needs_check")
  /// 게시 중(POSTING)으로 잡은 시각 — 오래 남아 있으면 자동으로 되돌린다
  postingAt   DateTime?    @map("posting_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  draft    ReplyDraft?
  reply    Reply?

  @@unique([propertyId, channel, externalId])
  @@index([propertyId, status, postedAt])
  @@map("wj_review")
}

model ReplyDraft {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @unique @map("review_id") @db.Uuid
  text      String   @map("content")
  keywords  String[]
  generator String // 'anthropic:<model>' | 'template'
  /// 다시 만든 횟수 — 템플릿 답글은 이 값으로 표현을 돌려 쓴다
  revision  Int      @default(0) @map("revision_no")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("wj_review_reply_draft")
}

model Reply {
  id          String    @id @default(uuid()) @db.Uuid
  reviewId    String    @unique @map("review_id") @db.Uuid
  text        String    @map("content")
  via         ReplyVia  @map("post_method")
  postedById  String?   @map("posted_by") @db.Uuid
  /// 게시 시각. EXTERNAL 은 채널이 준 답글 시각 (채널이 안 주면 null)
  postedAt    DateTime? @default(now()) @map("posted_at") @db.Timestamptz
  /// 게시한 문장이 AI 초안과 달랐는지 (초안 없이 게시·EXTERNAL 이면 null)
  draftEdited Boolean?  @map("is_draft_edited")

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  postedBy User?  @relation(fields: [postedById], references: [id], onDelete: SetNull)

  @@map("wj_review_reply")
}

enum Tone {
  POLITE
  FRIENDLY

  @@map("wj_reply_tone")
}

enum AutoHours {
  ALWAYS
  DAYTIME

  @@map("wj_auto_reply_hours")
}

model ReplySettings {
  propertyId    String    @id @map("property_id") @db.Uuid
  tone          Tone      @default(POLITE)
  signature     String
  mustInclude   String    @default("") @map("must_include")
  banned        String[]  @default([]) @map("banned_words")
  autoEnabled   Boolean   @default(false) @map("is_auto_reply")
  autoMinRating Int       @default(4) @map("auto_min_rating")
  autoHours     AutoHours @default(ALWAYS) @map("auto_hours")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("wj_reply_setting")
}

// ═══ 알림 (F0-13) ═════════════════════════════════════════════

enum NotificationKind {
  REVIEW
  SETTLE
  SYNC
  BILLING
  STAFF
  /// 아침 8시 일일 요약 (앱 알림만, 문자 없음)
  SUMMARY

  @@map("wj_notice_type")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  propertyId String           @map("property_id") @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  kind       NotificationKind @map("notice_type")
  text       String           @map("message")
  link       String?          @map("link_url")
  readAt     DateTime?        @map("read_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("wj_notification")
}

/// 알림 종류별 받기 설정 — 없으면 기본값(알림톡·앱 푸시 켬)
model NotificationSetting {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  propertyId String           @map("property_id") @db.Uuid
  kind       NotificationKind @map("notice_type")
  alimtalk   Boolean          @default(true) @map("is_alimtalk")
  push       Boolean          @default(true) @map("is_push")
  email      Boolean          @default(false) @map("is_email")
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId, kind])
  @@map("wj_notification_setting")
}

// ═══ 구독 · 결제 (F0-08, F0-09) ═══════════════════════════════

enum PlanCode {
  REVIEW
  LEDGER
  STAFF
  EXPENSE
  FINANCE

  @@map("wj_plan_code")
}

model Plan {
  code         PlanCode @id @map("plan_code")
  name         String   @map("plan_name")
  monthlyPrice Int      @map("monthly_price")
  description  String
  stageLabel   String   @map("stage_label")
  isAvailable  Boolean  @default(true) @map("is_available")
  sortOrder    Int      @default(0) @map("sort_order")

  subscriptions Subscription[]

  @@map("wj_plan")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED

  @@map("wj_subscription_status")
}

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  propertyId    String             @map("property_id") @db.Uuid
  planCode      PlanCode           @map("plan_code")
  status        SubscriptionStatus @default(TRIAL)
  trialEndsAt   DateTime           @map("trial_end_date") @db.Date
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz
  cancelledAt   DateTime?          @map("cancelled_at") @db.Timestamptz
  /// 마지막으로 결제를 마친 달 (그 달 1일) — 같은 달 두 번 결제하지 않는다
  paidMonth     DateTime?          @map("paid_month") @db.Date
  /// 체험 종료 3일 전 알림을 보낸 시각 — 한 번만 보낸다
  trialNoticeAt DateTime?          @map("trial_notice_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planCode], references: [code])

  @@unique([propertyId, planCode])
  @@map("wj_subscription")
}

model PaymentMethod {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  cardName   String   @map("card_name")
  cardLast4  String   @map("card_last4")
  /// PG 빌링키 (암호화)
  billingKey String   @map("billing_key_enc")
  isDefault  Boolean  @default(true) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("wj_payment_method")
}

enum PaymentStatus {
  PAID
  FAILED
  REFUNDED

  @@map("wj_payment_status")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  propertyId  String        @map("property_id") @db.Uuid
  billedMonth DateTime      @map("billed_month") @db.Date
  description String
  amount      Int           @map("pay_amount")
  status      PaymentStatus
  /// PG 주문번호 = 멱등 키 (업장·달·종류·시도 순번으로 정해짐)
  orderNo     String?       @unique @map("order_no")
  paidAt      DateTime      @default(now()) @map("paid_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, paidAt])
  @@map("wj_payment")
}

// ═══ 알바관리 (F5-01 ~ F5-04, F5-06) ══════════════════════════

enum JobRole {
  MANAGER
  FRONT
  NIGHT
  HOUSEKEEPING

  @@map("wj_job_role")
}

enum PayType {
  HOURLY
  MONTHLY

  @@map("wj_pay_type")
}

model Employee {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @map("property_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid // 앱 계정과 연결되면 본인이 출퇴근 기록
  name       String    @map("employee_name")
  phone      String    @map("phone_no")
  jobRole    JobRole   @map("job_role")
  payType    PayType   @map("pay_type")
  payAmount  Int       @map("pay_amount") // 시급 또는 월급
  hiredDate  DateTime  @map("hired_date") @db.Date
  resignedAt DateTime? @map("resigned_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts   LaborContract[]
  attendances Attendance[]
  shifts      WorkShift[]
  payrolls    Payroll[]

  @@index([propertyId])
  @@map("wj_employee")
}

enum ContractStatus {
  SENT
  SIGNED

  @@map("wj_contract_status")
}

model LaborContract {
  id         String         @id @default(uuid()) @db.Uuid
  employeeId String         @map("employee_id") @db.Uuid
  status     ContractStatus @default(SENT)
  startDate  DateTime       @map("contract_start_date") @db.Date
  payType    PayType        @map("pay_type")
  payAmount  Int            @map("pay_amount")
  tokenHash  String         @unique @map("sign_token_hash")
  sentAt     DateTime       @default(now()) @map("sent_at") @db.Timestamptz
  signedAt   DateTime?      @map("signed_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("wj_labor_contract")
}

enum ClockMethod {
  GPS
  QR
  MANUAL

  @@map("wj_clock_method")
}

model Attendance {
  id         String      @id @default(uuid()) @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  workDate   DateTime    @map("work_date") @db.Date
  clockInAt  DateTime    @map("clock_in_at") @db.Timestamptz
  clockOutAt DateTime?   @map("clock_out_at") @db.Timestamptz
  method     ClockMethod @default(GPS) @map("clock_method")
  editedById String?     @map("edited_by") @db.Uuid
  editedAt   DateTime?   @map("edited_at") @db.Timestamptz
  memo       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@map("wj_attendance")
}

enum ShiftType {
  DAY
  NIGHT
  OFF

  @@map("wj_shift_type")
}

model WorkShift {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  workDate   DateTime  @map("work_date") @db.Date
  shiftType  ShiftType @map("shift_type")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@map("wj_work_shift")
}

enum PayrollStatus {
  DRAFT
  CONFIRMED
  SENT

  @@map("wj_payroll_status")
}

model Payroll {
  id           String        @id @default(uuid()) @db.Uuid
  employeeId   String        @map("employee_id") @db.Uuid
  month        DateTime      @map("pay_month") @db.Date // 그 달 1일
  workHours    Decimal       @map("work_hours") @db.Decimal(6, 2)
  nightHours   Decimal       @map("night_hours") @db.Decimal(6, 2)
  baseAmount   Int           @map("base_amount")
  nightAmount  Int           @map("night_amount")
  weeklyAmount Int           @map("weekly_holiday_amount")
  totalAmount  Int           @map("total_amount")
  status       PayrollStatus @default(DRAFT)
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz
  sentAt       DateTime?     @map("sent_at") @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@map("wj_payroll")
}

// ═══ 지출관리 (F6-01, F6-03, F6-04) ═══════════════════════════

enum ExpenseCategory {
  AMENITY
  UTILITY
  LAUNDRY
  FOOD
  REPAIR
  TAX
  ETC

  @@map("wj_expense_category")
}

enum ExpenseSource {
  CARD
  RECEIPT
  ORDER
  MANUAL

  @@map("wj_expense_source")
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  propertyId  String          @map("property_id") @db.Uuid
  expenseDate DateTime        @map("expense_date") @db.Date
  vendor      String          @map("vendor_name")
  category    ExpenseCategory @map("expense_category")
  amount      Int             @map("expense_amount")
  source      ExpenseSource   @default(MANUAL) @map("expense_source")
  memo        String?
  createdById String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  receipt  Receipt?
  order    PurchaseOrder?

  @@index([propertyId, expenseDate])
  @@map("wj_expense")
}

enum ReceiptStatus {
  SCANNED
  REGISTERED

  @@map("wj_receipt_status")
}

/// 영수증 사진 + 글자 인식(OCR) 결과 (F6-03)
model Receipt {
  id           String           @id @default(uuid()) @db.Uuid
  propertyId   String           @map("property_id") @db.Uuid
  fileName     String           @map("file_name")
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  storagePath  String           @map("storage_path")
  ocrVendor    String?          @map("ocr_vendor_name")
  ocrDate      DateTime?        @map("ocr_expense_date") @db.Date
  ocrAmount    Int?             @map("ocr_amount")
  ocrCategory  ExpenseCategory? @map("ocr_category")
  status       ReceiptStatus    @default(SCANNED)
  expenseId    String?          @unique @map("expense_id") @db.Uuid
  uploadedById String?          @map("uploaded_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  expense  Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@map("wj_receipt")
}

enum OrderStatus {
  REQUESTED
  ORDERED
  RECEIVED
  CANCELLED

  @@map("wj_order_status")
}

model PurchaseOrder {
  id          String          @id @default(uuid()) @db.Uuid
  propertyId  String          @map("property_id") @db.Uuid
  itemName    String          @map("item_name")
  quantity    Int
  unit        String
  vendor      String          @map("vendor_name")
  amount      Int             @map("order_amount")
  category    ExpenseCategory @default(AMENITY) @map("expense_category")
  status      OrderStatus     @default(REQUESTED) @map("order_status")
  requestedAt DateTime        @default(now()) @map("requested_at") @db.Timestamptz
  orderedAt   DateTime?       @map("ordered_at") @db.Timestamptz
  receivedAt  DateTime?       @map("received_at") @db.Timestamptz
  expenseId   String?         @unique @map("expense_id") @db.Uuid
  createdById String?         @map("created_by") @db.Uuid

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  expense  Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([propertyId, requestedAt])
  @@map("wj_purchase_order")
}

// ═══ 현장 업무 (F7-01 ~ F7-03) ════════════════════════════════
// 사업소개서 5대 서비스 '내부 업무시스템' — 객실 상태 · 교대 인수인계 · 공지

enum RoomStatus {
  READY // 판매 가능 (청소·점검 끝)
  OCCUPIED // 투숙 중
  DIRTY // 청소 필요 (퇴실)
  CLEANING // 청소 중
  INSPECT // 점검 필요 (청소 끝, 확인 전)
  OUT_OF_ORDER // 판매 중지 (고장·수리)

  @@map("wj_room_status")
}

/// 객실 (호실 단위) — 상태판 (F7-01)
model Room {
  id                String     @id @default(uuid()) @db.Uuid
  propertyId        String     @map("property_id") @db.Uuid
  number            String     @map("room_no") // 예: 201, 별관-3
  floor             Int?       @map("floor_no")
  roomType          String?    @map("room_type_name")
  sortOrder         Int        @default(0) @map("sort_order")
  status            RoomStatus @default(READY)
  memo              String? // 현재 상태 메모 (예: 에어컨 소음)
  statusChangedAt   DateTime   @default(now()) @map("status_changed_at") @db.Timestamptz
  statusChangedById String?    @map("status_changed_by") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  logs     RoomStatusLog[]

  @@unique([propertyId, number])
  @@index([propertyId, status])
  @@map("wj_room")
}

/// 객실 상태 변경 이력 — 누가 언제 청소·점검했는지 (F7-01)
model RoomStatusLog {
  id          String      @id @default(uuid()) @db.Uuid
  roomId      String      @map("room_id") @db.Uuid
  fromStatus  RoomStatus? @map("from_status")
  toStatus    RoomStatus  @map("to_status")
  memo        String?
  changedById String?     @map("changed_by") @db.Uuid
  changedAt   DateTime    @default(now()) @map("changed_at") @db.Timestamptz

  room      Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([roomId, changedAt])
  @@map("wj_room_status_log")
}

enum OpsNoteKind {
  HANDOVER // 교대 인수인계 (F7-02)
  NOTICE // 공지 (F7-03)

  @@map("wj_ops_note_type")
}

/// 인수인계 · 공지 글
model OpsNote {
  id         String      @id @default(uuid()) @db.Uuid
  propertyId String      @map("property_id") @db.Uuid
  kind       OpsNoteKind @map("note_type")
  shift      ShiftType?  @map("shift_type") // 인수인계를 쓴 근무 (주간 → 야간 등)
  body       String
  isPinned   Boolean     @default(false) @map("is_pinned")
  authorId   String?     @map("author_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reads    OpsNoteRead[]

  @@index([propertyId, kind, createdAt])
  @@map("wj_ops_note")
}

/// 인수인계·공지 확인 표시 (누가 읽었는지)
model OpsNoteRead {
  noteId String   @map("note_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  readAt DateTime @default(now()) @map("read_at") @db.Timestamptz

  note OpsNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@map("wj_ops_note_read")
}

// ═══ 실증 측정 · 운영 도구 (2차 PO) ═══════════════════════════

/**
 * 사용 기록 — 실증 KPI(주간 사용일·장부 조회일·AI 답글 사용량)용. 서버가 남기고, 실패해도 본 요청에는 영향 없다.
 * kind: APP_OPEN · OVERVIEW_VIEW · LEDGER_VIEW · REPORT_VIEW · DRAFT_CREATE · DRAFT_REGENERATE · REPLY_POST ·
 * CHANNEL_CONNECT · RECEIPT_REGISTER · PAYROLL_CONFIRM · CLOCK_IN · ROOM_STATUS
 * propertyId 가 없으면 사용자 단위(앱 열기·통합 현황) — 그 사용자가 사장님·매니저인 업장 전부의 사용으로 센다.
 */
model UsageEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  propertyId String?  @map("property_id") @db.Uuid
  kind       String   @map("event_kind")
  meta       Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([propertyId, kind, createdAt])
  @@index([userId, kind, createdAt])
  @@map("wj_usage_event")
}

/// 채널별 업장 평점 — 수집할 때 하루 한 줄 (같은 날 다시 수집하면 덮어쓴다)
model RatingSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  channel     Channel  @map("channel_code")
  date        DateTime @map("snapshot_date") @db.Date
  rating      Decimal  @db.Decimal(3, 2)
  reviewCount Int      @map("review_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, channel, date])
  @@map("wj_rating_snapshot")
}

/// 운영팀 지원 메모 — 통화·방문 기록
model SupportNote {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  kind       String   @map("note_kind") // CALL · VISIT · ETC
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  property Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  admin    AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@map("wj_support_note")
}

/// 실증 설문 값 — 기준선(시작 전) · 만족도(4주·8주) · 지불의사. 설문 자체는 외부 폼, 운영팀이 옮겨 적는다
model PilotSurvey {
  propertyId          String   @id @map("property_id") @db.Uuid
  /// 하루 채널 확인에 쓰는 시간(분)
  channelCheckMinutes Int?     @map("channel_check_min")
  /// 급여 계산 방식 (예: 엑셀, 수기)
  payrollMethod       String?  @map("payroll_method")
  /// 한 달 급여 계산에 드는 시간(분)
  payrollMinutes      Int?     @map("payroll_min")
  staffCount          Int?     @map("staff_count")
  /// 한 달 지출 건수
  monthlyExpenseCount Int?     @map("monthly_expense_count")
  /// 지출·장부 기록 방식
  recordMethod        String?  @map("record_method")
  baselineMemo        String?  @map("baseline_memo")
  satisfaction4w      Int?     @map("satisfaction_4w") // 1~5
  satisfaction8w      Int?     @map("satisfaction_8w") // 1~5
  satisfactionMemo    String?  @map("satisfaction_memo")
  /// 지불의사 — 고른 요금제 이름
  wtpPlan             String?  @map("wtp_plan")
  wtpProperties       Int?     @map("wtp_property_count")
  wtpMemo             String?  @map("wtp_memo")
  updatedById         String?  @map("updated_by") @db.Uuid
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("wj_pilot_survey")
}
