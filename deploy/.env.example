# deploy/.env — 서버에서만 만들고 git 에 올리지 않는다 (cp .env.example .env)

# 접속 주소 (DNS A 레코드를 Lightsail 고정 IP 로)
DOMAIN=app.woojoostay.com

# DB 비밀번호 — openssl rand -base64 24
DB_PASSWORD=

# 토큰 서명 키 2개 (각각 다른 값) — openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 채널 계정 정보 암호화 키 — openssl rand -base64 32  (바꾸면 저장된 채널 계정을 못 읽음!)
CREDENTIALS_KEY=

# 화면 서버 → API 내부 호출 확인 키 (요청 제한을 실제 사용자 IP 기준으로) — openssl rand -base64 48
INTERNAL_API_KEY=

# 채널 자동 수집(30분) · 매일 9시 정기결제
SYNC_ENABLED=true

# 급한 알림(저평점 리뷰 · 채널 연동 끊김)을 사장님·매니저에게 문자로도 (알리고 키 필요)
SMS_ALERTS_ENABLED=false

# 새 업장 무료 체험 일수 — 8주 실증이면 56
TRIAL_DAYS=56

# 운영에서 결제(토스)·문자(알리고) 키가 없으면 API가 시작하지 않아요.
# 키 없이 파일럿을 시작하려면 true (그동안 결제는 기록만, 문자는 로그에만 남아요)
ALLOW_FAKE_INTEGRATIONS=false

# ── 외부 연동 (비워 두면 개발용 가짜로 동작) ──
# AI 답글 · 영수증 인식
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# 국세청 사업자 상태조회 (공공데이터포털 일반 인증키 · Decoding 값)
NTS_SERVICE_KEY=
# 알리고 문자 (발신번호 등록 + 이 서버 고정 IP 등록 필요)
ALIGO_API_KEY=
ALIGO_USER_ID=
SMS_SENDER=
# 토스페이먼츠 자동결제 — 시크릿 키는 API, 클라이언트 키는 화면
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
